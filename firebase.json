{
  "hosting": [
    {
      "site": "bridge-to-btech",
      "public": "frontend",
      "headers": [
        {
          "source": "/@(index.html|sw.js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "birdge-to-btech",
      "public": "frontend",
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://bridge-to-btech.web.app/:path*",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
