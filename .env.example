# Inter2Tech Server Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=inter2tech_jwt_secret_secure_key_2025_2026_counseling_companion

# Development Fallback OTP: set to true to allow '000000' as a backup code during testing
DEV_FALLBACK_OTP=true

# Google OAuth web client ID (required for Google sign-in)
GOOGLE_CLIENT_ID=

# Email SMTP Settings (Leave empty for console dev simulation)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Inter2Tech Counseling Portal" <no-reply@inter2tech.com>

# Optional SMS Gateway (e.g. Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
